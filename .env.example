# ================================================================
# Front-end (Render > Static Site > Environment) — valores PÚBLICOS
# ================================================================
# URL do projeto Supabase (Project Settings > API > Project URL)
VITE_SUPABASE_URL=
# Chave pública "anon" (Project Settings > API > anon public)
VITE_SUPABASE_ANON_KEY=

# ================================================================
# SOMENTE para scripts locais de dados fictícios (npm run demo:seed)
# NUNCA cadastre esta chave no Render nem a envie ao navegador.
# Na Edge Function "admin-users" ela já é fornecida pelo Supabase.
# ================================================================
SUPABASE_SERVICE_ROLE_KEY=
# Senha usada nos usuários fictícios criados pelo demo:seed
DEMO_PASSWORD=
