{
  "name": "baixas-estoque-qrcode",
  "private": true,
  "version": "1.0.0",
  "description": "Controle de saída de materiais de estoque por QR Code - Muribeca e Dois Irmãos",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sql:montar": "node scripts/montar-sql.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "demo:clean": "node scripts/demo-clean-storage.mjs",
    "test:sql": "bash supabase/tests/executar_testes_sql.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.10.1",
    "signature_pad": "^5.1.4",
    "sonner": "^2.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
