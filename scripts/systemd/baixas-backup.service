[Unit]
Description=Backup cifrado do Baixas de Estoque
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=baixas-backup
Group=baixas-backup
WorkingDirectory=/opt/baixadeestoque
Environment=BACKUP_DIR=/mnt/baixas-backups
EnvironmentFile=/etc/baixas-backup/env
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
# Impede gravar por engano no disco local quando o destino externo não estiver montado.
ExecStartPre=/usr/bin/mountpoint --quiet /mnt/baixas-backups
ExecStart=/usr/bin/python3 /opt/baixadeestoque/scripts/backup-retention.py
# Nunca interromper uma cópia longa por um limite padrão de 90 segundos.
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal
